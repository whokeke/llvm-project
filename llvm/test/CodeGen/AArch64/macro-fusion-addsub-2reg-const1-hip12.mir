# RUN: llc -o - %s -mtriple=aarch64-- -mcpu=hip12 -run-pass postmisched \
# RUN:   | FileCheck %s --check-prefixes=CHECK,HIP12
# RUN: llc -o - %s -mtriple=aarch64-- -mcpu=hip12 -mattr=-fuse-addsub-2reg-const1 \
# RUN:   -run-pass postmisched | FileCheck %s --check-prefixes=CHECK,NOFUSION

# Verify that -mcpu=hip12 enables FeatureFuseAddSub2RegAndConstOne.
#
# Pattern:  ADDXrr x0, x1   followed by   ADDXri <dst>, 1
#          SUBXrr x2, x3   followed by   SUBXri <dst>, 1
#
# With the feature ON  the post-misched pass keeps each (ADDrr, ADDri#1)
# pair adjacent so the hardware can fuse them.
# With the feature OFF the scheduler is free to interleave the two
# independent chains, putting SUBXrr between ADDXrr and ADDXri#1.
#
# Background: upstream TuneHIP12 (commit d87350127163) did not enable
# FeatureFuseAddSub2RegAndConstOne.  Empirical evaluation on a real HIP12
# system (Part 0xD06, 2.3 GHz, kernel 6.6) shows the hardware fuses
# (A + B) + 1 patterns, giving a 10-16% wall-clock speed-up vs. the
# NOP-split variant over 50M iterations.  See HIP12 fusion-benefit bench T2.

# CHECK-LABEL: name: addsub2reg_hip12
# CHECK: $x8 = ADDXrr killed renamable $x0, killed renamable $x1
# HIP12: renamable $x0 = ADDXri killed renamable $x8, 1, 0
# CHECK: $x9 = SUBXrr killed renamable $x2, killed renamable $x3
# NOFUSION: renamable $x0 = ADDXri killed renamable $x8, 1, 0
# CHECK: renamable $x1 = SUBXri killed renamable $x9, 1, 0

--- |
  define void @addsub2reg_hip12(i64 %a, i64 %b, i64 %c, i64 %d) nounwind {
  entry:
    %x = add i64 %a, %b
    %x1 = add i64 %x, 1
    %y = sub i64 %c, %d
    %y1 = sub i64 %y, 1
    %or = or i64 %x1, %y1
    ret void
  }
...
---
name: addsub2reg_hip12
tracksRegLiveness: true
body: |
  bb.0.entry:
    liveins: $x0, $x1, $x2, $x3

    $x8 = ADDXrr killed renamable $x0, killed renamable $x1
    $x9 = SUBXrr killed renamable $x2, killed renamable $x3
    renamable $x0 = ADDXri killed renamable $x8, 1, 0
    renamable $x1 = SUBXri killed renamable $x9, 1, 0

    $x0 = ORRXrs killed renamable $x0, killed renamable $x1, 0
    RET_ReallyLR implicit $x0
...
